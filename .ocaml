
type producto = {
  nombre : string;
  precio : float;
}


let productos = [
  { nombre = "Mouse"; precio = 25.0 };
  { nombre = "Teclado"; precio = 50.0 };
  { nombre = "Monitor"; precio = 200.0 };
]


let total lista =
  List.fold_left (fun acc p -> acc +. p.precio) 0.0 lista

let () =
  print_endline "Lista de productos:";
  List.iter (fun p ->
    Printf.printf "%s - Q%.2f\n" p.nombre p.precio
  ) productos;

  Printf.printf "\nTotal: Q%.2f\n" (total productos)

